# POI Benchmark — configuration. Copy to .env and fill in. Never commit .env.

# --- AI Refinery (LLM for every framework, via its OpenAI-compatible API) ---
AIREFINERY_API_KEY=
AIREFINERY_BASE_URL=
# The gateway rejects requests without an sdk_version header (it misreports this as
# "Invalid or expired token"). Use the installed airefinery-sdk version, e.g. 1.33.0.
AIREFINERY_SDK_VERSION=
AIREFINERY_MODEL=openai/gpt-oss-120b

# --- Run provenance ---
# Recorded in every result file as run_metadata.runner (who or what ran the benchmark).
POI_RUNNER=local

# --- Real backing services ---
# Not set here: ./infra.sh up port-forwards Postgres, Neo4j, RabbitMQ and the in-cluster
# Jaeger, starts the remaining stubs, and writes all addresses and credentials to
# .env.infra (gitignored, read from the cluster's K8s secrets). Cluster selection:
KUBE_CONTEXT=orbstack
POI_INFRA_NAMESPACE=platform
POI_TRACING_NAMESPACE=istio-system

# --- Measured scenarios (RLC, SMA, AHQ) ---
# Repeats per framework and scenario; scores are the median of these.
POI_REPEATS=5
# Frameworks run concurrently (each in its own venv).
POI_PARALLEL=5
# RLC: the harness kills a runaway loop at this many tool calls (= "not contained by default").
POI_RLC_MAX_CALLS=100
# RLC: the limit set in the second trial to check the framework's documented cap is honoured.
POI_RLC_CONFIGURED_LIMIT=5
# AHQ: seconds the approval waits in RabbitMQ while no agent process exists.
POI_AHQ_PAUSE_S=20

# --- MCP server URLs (written by ./infra.sh up; listed here for manual override) ---
MOCK_API_MCP_URL=http://127.0.0.1:9001/mcp
MOCK_CRM_MCP_URL=http://127.0.0.1:9002/mcp
MOCK_APPROVAL_MCP_URL=http://127.0.0.1:9003/mcp
MOCK_ML_MCP_URL=http://127.0.0.1:9102/mcp
MOCK_CHANNEL_MCP_URL=http://127.0.0.1:9103/mcp
