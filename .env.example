# POI Benchmark — required environment variables
# Copy to .env and fill in values. Never commit .env.

# AI Refinery — LLM backend for all framework adapters
AIREFINERY_API_KEY=
AIREFINERY_MODEL=openai/gpt-oss-120b

# AI Refinery OpenAI-compatible base URL (needed for LangChain/LangGraph ChatOpenAI adapter)
# Find this in the AI Refinery SDK internals or docs
AIREFINERY_BASE_URL=

# GEW mock infrastructure — set automatically if using docker-compose
MOCK_API_URL=http://localhost:8001
MOCK_CRM_URL=http://localhost:8002
APPROVAL_URL=http://localhost:8003

# TCW mock infrastructure — set automatically if using docker-compose
NEO4J_STUB_URL=http://localhost:8101
ML_ENDPOINT_URL=http://localhost:8102
CHANNEL_ADAPTER_URL=http://localhost:8103

# Observability — Prometheus endpoint for Pillar 3 probing
PROMETHEUS_URL=http://localhost:9090

# Runner identity — used in run_metadata.runner
POI_RUNNER=local
