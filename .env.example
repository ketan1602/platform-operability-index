# POI Benchmark — configuration template.
# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# LLM Provider — set these three for whichever provider you have access to.
# The harness reads LLM_* first; AIREFINERY_* names are accepted as fallback
# for Accenture-internal users.
# ---------------------------------------------------------------------------

# Option A — OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# MODEL_ID=gpt-4o

# Option B — Anthropic (Claude)
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=sk-ant-...
# MODEL_ID=claude-sonnet-4-5

# Option C — AI Refinery (Accenture-internal; OpenAI-compatible)
# LLM_BASE_URL=https://<your-refinery-host>/v1
# LLM_API_KEY=
# MODEL_ID=openai/gpt-oss-120b
# AIREFINERY_SDK_VERSION=2

# Option D — Any OpenAI-compatible endpoint (Ollama, LiteLLM, Azure OpenAI …)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# MODEL_ID=llama3.2

# Set one block above, then set these two:
LLM_BASE_URL=
LLM_API_KEY=
MODEL_ID=

# ---------------------------------------------------------------------------
# Benchmark behaviour
# ---------------------------------------------------------------------------

# Set to true to skip all LLM calls and external services; returns canned
# fixtures. Validates harness wiring without credentials or infrastructure.
DRY_RUN=false

# Run provenance — recorded in every result file.
POI_RUNNER=local

# Repeats per framework × scenario; scores are the median of these.
POI_REPEATS=5

# Frameworks run concurrently (each in its own venv subprocess).
POI_PARALLEL=5

# RLC: the harness kills a runaway loop at this many tool calls.
POI_RLC_MAX_CALLS=100

# RLC: the limit set in the second trial to verify the framework's documented cap.
POI_RLC_CONFIGURED_LIMIT=5

# AHQ: seconds the approval waits in RabbitMQ while no agent process exists.
POI_AHQ_PAUSE_S=20

# ---------------------------------------------------------------------------
# Infrastructure — written by ./infra.sh up into .env.infra (gitignored).
# Listed here for manual override when not using the K8s port-forward setup.
# ---------------------------------------------------------------------------

# POSTGRES_URL=postgresql://poi:poi@localhost:5432/poi
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# PROMETHEUS_URL=http://localhost:9090
# JAEGER_QUERY_URL=http://localhost:16686

# Cluster selection (used by infra.sh and deploy-mocks.sh).
KUBE_CONTEXT=orbstack
POI_INFRA_NAMESPACE=platform
POI_TRACING_NAMESPACE=istio-system

# ---------------------------------------------------------------------------
# Mock service URLs — written by ./infra.sh up; listed for manual override.
# ---------------------------------------------------------------------------
MOCK_API_MCP_URL=http://127.0.0.1:9001/mcp
MOCK_CRM_MCP_URL=http://127.0.0.1:9002/mcp
MOCK_APPROVAL_MCP_URL=http://127.0.0.1:9003/mcp
MOCK_ML_MCP_URL=http://127.0.0.1:9102/mcp
MOCK_CHANNEL_MCP_URL=http://127.0.0.1:9103/mcp
